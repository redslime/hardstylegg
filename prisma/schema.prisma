generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "esm"
}

datasource db {
  provider          = "mysql"
}

model album {
  sid                 String                @id @db.Char(22)
  title               String?               @db.VarChar(128)
  date                DateTime              @default(dbgenerated("'1970-01-01'")) @db.Date
  cover_art           String?               @db.Char(40)
  hidden              Boolean               @default(dbgenerated("b'0'")) @db.Bit(1)
  album_artist        album_artist[]
  album_track         album_track[]
  game_complete_album game_complete_album[]
}

model game_artwork {
  id            Int     @id @default(autoincrement())
  created_by    Int
  track_id      String  @db.Char(22)
  artwork_blank String  @db.VarChar(64)
  context       String? @db.VarChar(1024)
  track         track   @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_artwork_track_sid_fk")
  user          user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_artwork_user_id_fk")

  @@index([track_id], map: "game_artwork_track_sid_fk")
  @@index([created_by], map: "game_artwork_user_id_fk")
}

model game_complete_album {
  id                       Int                        @id @default(autoincrement())
  created_by               Int
  album_id                 String?                    @db.Char(22)
  context                  String?                    @db.VarChar(1024)
  album                    album?                     @relation(fields: [album_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_album_album_sid_fk")
  user                     user                       @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_album_user_id_fk")
  game_complete_album_item game_complete_album_item[]

  @@index([created_by], map: "game_complete_album_user_id_fk")
  @@index([album_id], map: "game_complete_album_album_sid_fk")
}

model game_complete_album_item {
  id                  Int                 @id @default(autoincrement())
  parent_id           Int
  name                String              @db.VarChar(128)
  artist              String              @db.VarChar(128)
  hidden              Boolean             @default(dbgenerated("b'0'")) @db.Bit(1)
  context             String?             @db.VarChar(1024)
  game_complete_album game_complete_album @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_complete_album_item_8_game_complete_album_id_fk")

  @@index([parent_id], map: "game_complete_album_item_8_game_complete_album_id_fk")
}

model game_complete_lyrics {
  id         Int     @id @default(autoincrement())
  created_by Int
  text       String  @db.Text
  track_id   String  @db.Char(22)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_lyrics_user_id_fk")

  @@index([created_by], map: "game_complete_lyrics_user_id_fk")
}

model game_heardle {
  id         Int     @id @default(autoincrement())
  created_by Int
  track_id   String  @db.Char(22)
  src        String  @db.VarChar(64)
  durations  String  @db.VarChar(128)
  context    String? @db.VarChar(1024)
  track      track   @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_heardle_track_sid_fk")
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_heardle_user_id_fk")

  @@index([track_id], map: "game_heardle_track_sid_fk")
  @@index([created_by], map: "game_heardle_user_id_fk")
}

model game_namex {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       Int
  tracks     Boolean @default(dbgenerated("b'1'")) @db.Bit(1)
  items      String  @db.VarChar(1024)
  context    String? @db.VarChar(1024)
  type       String  @default("") @db.VarChar(16)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_namex_user_id_fk")

  @@index([created_by], map: "game_namex_user_id_fk")
}

model game_order {
  id              Int               @id @default(autoincrement())
  created_by      Int
  title           String            @db.VarChar(64)
  show_names      Boolean           @default(dbgenerated("b'1'")) @db.Bit(1)
  context         String?           @db.VarChar(1024)
  user            user              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_order_user_id_fk")
  game_order_item game_order_item[]

  @@index([created_by], map: "game_order_user_id_fk")
}

model game_order_item {
  parent_id  Int
  index      Int
  track_id   String     @db.Char(22)
  context    String?    @db.VarChar(1024)
  game_order game_order @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_order_item_game_order_id_fk")
  track      track      @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_order_item_track_sid_fk")

  @@id([parent_id, index])
  @@index([track_id], map: "game_order_item_track_sid_fk")
}

model game_quiz {
  id             Int              @id @default(autoincrement())
  created_by     Int
  title          String?          @db.VarChar(128)
  context        String?          @db.VarChar(1024)
  user           user             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_quiz_user_id_fk")
  game_quiz_item game_quiz_item[]

  @@index([created_by], map: "game_quiz_user_id_fk")
}

model game_quiz_item {
  id        Int       @id @default(autoincrement())
  parent_id Int
  text      String    @db.VarChar(64)
  correct   Boolean   @default(dbgenerated("b'0'")) @db.Bit(1)
  context   String?   @db.VarChar(1024)
  game_quiz game_quiz @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_quiz_item_game_quiz_id_fk")

  @@index([parent_id], map: "game_quiz_item_game_quiz_id_fk")
}

model game_timeline {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       Int     @db.Year
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_timeline_user_id_fk")

  @@index([created_by], map: "game_timeline_user_id_fk")
}

model game_timetable {
  id                  Int                   @id @default(autoincrement())
  created_by          Int
  title               String                @db.VarChar(128)
  color_bg            String                @db.Char(6)
  color_text          String                @db.Char(6)
  context             String?               @db.VarChar(1024)
  user                user                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_timetable_user_id_fk")
  game_timetable_item game_timetable_item[]

  @@index([created_by], map: "game_timetable_user_id_fk")
}

model game_timetable_item {
  id             Int            @id @default(autoincrement())
  parent_id      Int
  name           String         @db.VarChar(64)
  begin          String?        @db.VarChar(5)
  end            String?        @db.VarChar(5)
  hidden         Boolean        @default(dbgenerated("b'0'")) @db.Bit(1)
  context        String?        @db.VarChar(1024)
  game_timetable game_timetable @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_timetable_item_game_timetable_id_fk")

  @@index([parent_id], map: "game_timetable_item_game_timetable_id_fk")
}

model track {
  sid                      String                     @id @db.Char(22)
  title                    String?                    @db.VarChar(128)
  date                     DateTime                   @default(dbgenerated("'1970-01-01'")) @db.Date
  cover_art                String?                    @db.Char(40)
  hidden                   Boolean                    @default(dbgenerated("b'0'")) @db.Bit(1)
  album_track              album_track[]
  game_artwork             game_artwork[]
  game_heardle             game_heardle[]
  game_lost_in_translation game_lost_in_translation[]
  game_order_item          game_order_item[]
  track_artist             track_artist[]
}

model user {
  id                       Int                        @id @default(autoincrement())
  discord_id               String                     @unique(map: "user_pk") @db.Char(18)
  name                     String                     @db.VarChar(32)
  admin                    Boolean                    @default(dbgenerated("b'0'")) @db.Bit(1)
  game_artwork             game_artwork[]
  game_complete_album      game_complete_album[]
  game_complete_lyrics     game_complete_lyrics[]
  game_heardle             game_heardle[]
  game_lost_in_translation game_lost_in_translation[]
  game_map                 game_map[]
  game_namex               game_namex[]
  game_navigator           game_navigator[]
  game_order               game_order[]
  game_puzzle              game_puzzle[]
  game_quiz                game_quiz[]
  game_timeline            game_timeline[]
  game_timetable           game_timetable[]
  game_wordle              game_wordle[]
  game_zoomer              game_zoomer[]
  list                     list[]
}

model day_schedule {
  day      Int     @id @default(autoincrement())
  type_ids String  @db.VarChar(32)
  game_ids String  @db.VarChar(32)
  theme    String? @db.VarChar(64)
}

model report {
  code        String        @id @db.Char(15)
  dayId       Int
  completed   Boolean       @default(dbgenerated("b'0'")) @db.Bit(1)
  successes   Int           @default(0)
  app         Boolean       @default(dbgenerated("b'0'")) @db.Bit(1)
  report_item report_item[]
}

model report_item {
  parent_code     String  @db.Char(15)
  typeId          Int
  gameId          Int
  success         Boolean @default(dbgenerated("b'0'")) @db.Bit(1)
  attempts        Int?
  items_completed String? @db.VarChar(128)
  items_clicked   String? @db.VarChar(32)
  custom          String? @db.VarChar(128)
  report          report  @relation(fields: [parent_code], references: [code], onDelete: Cascade, map: "report_item_report_code_fk")

  @@id([parent_code, typeId, gameId])
  @@index([typeId, gameId], map: "report_item_typeId_gameId_index")
}

model game_map {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       String  @db.Char(2)
  context    String? @db.VarChar(1024)
  type       String  @default("countries") @db.VarChar(16)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_map_user_id_fk")

  @@index([created_by], map: "game_map_user_id_fk")
}

model game_zoomer {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       String  @db.VarChar(128)
  data       String  @db.VarChar(8192)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_zoomer_user_id_fk")

  @@index([created_by], map: "game_zoomer_user_id_fk")
}

model infinity {
  code     String @id @unique(map: "infinity_pk_2") @db.Char(6)
  type_ids String @db.VarChar(1024)
  game_ids String @db.VarChar(1024)
}

model game_lost_in_translation {
  id                Int     @id @unique(map: "game_lost_in_translation_pk_2") @default(autoincrement())
  created_by        Int
  track_id          String  @db.Char(22)
  original_text     String  @db.Text
  translated_text   String  @db.Text
  translation_chain String  @db.VarChar(512)
  context           String? @db.VarChar(1024)
  track             track   @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_lost_in_translation_track_sid_fk")
  user              user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_lost_in_translation_user_id_fk")

  @@index([track_id], map: "game_lost_in_translation_track_sid_fk")
  @@index([created_by], map: "game_lost_in_translation_user_id_fk")
}

model album_artist {
  album_id  String @db.Char(22)
  artist_id String @db.Char(22)
  album     album  @relation(fields: [album_id], references: [sid], onDelete: Cascade, map: "album_artist_album_sid_fk")
  artist    artist @relation(fields: [artist_id], references: [id], onDelete: Cascade, map: "album_artist_artist_id_fk")

  @@id([album_id, artist_id])
  @@index([artist_id], map: "album_artist_artist_id_fk")
}

model album_track {
  album_id String @db.Char(22)
  track_id String @db.Char(22)
  index    Int
  album    album  @relation(fields: [album_id], references: [sid], onDelete: Cascade, map: "album_track_album_sid_fk")
  track    track  @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "album_track_track_sid_fk")

  @@id([album_id, track_id, index])
  @@index([track_id], map: "album_track_track_sid_fk")
}

model artist {
  id                                                   String           @id @db.Char(22)
  name                                                 String           @db.VarChar(128)
  image                                                String?          @db.Char(40)
  album_artist                                         album_artist[]
  artist_stats                                         artist_stats[]
  game_navigator_game_navigator_from_artist_idToartist game_navigator[] @relation("game_navigator_from_artist_idToartist")
  game_navigator_game_navigator_to_artist_idToartist   game_navigator[] @relation("game_navigator_to_artist_idToartist")
  game_wordle_game_wordle_artistToartist               game_wordle[]    @relation("game_wordle_artistToartist")
  track_artist                                         track_artist[]
}

model radar_inbox {
  content_id String   @id @db.Char(22)
  added_on   DateTime @default(dbgenerated("(curdate())")) @db.Date
  album      Boolean  @default(dbgenerated("b'0'")) @db.Bit(1)
  data       String   @db.Text
}

model track_artist {
  track_id  String @db.Char(22)
  artist_id String @db.Char(22)
  artist    artist @relation(fields: [artist_id], references: [id], onDelete: Cascade, map: "track_artist_artist_id_fk")
  track     track  @relation(fields: [track_id], references: [sid], onDelete: Cascade, map: "track_artist_track_sid_fk")

  @@id([track_id, artist_id])
  @@index([artist_id], map: "track_artist_artist_id_fk")
}

model game_wordle {
  id                                Int     @id @default(autoincrement())
  created_by                        Int
  artist                            String  @db.Char(22)
  context                           String? @db.VarChar(1024)
  artist_game_wordle_artistToartist artist  @relation("game_wordle_artistToartist", fields: [artist], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_wordle_artist_id_fk")
  user                              user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_wordle_user_id_fk")

  @@index([artist], map: "game_wordle_artist_id_fk")
  @@index([created_by], map: "game_wordle_user_id_fk")
}

model game_navigator {
  id                                           Int     @id @default(autoincrement())
  created_by                                   Int
  from_artist_id                               String  @db.Char(22)
  to_artist_id                                 String  @db.Char(22)
  max_steps                                    Int
  context                                      String? @db.VarChar(1024)
  artist_game_navigator_from_artist_idToartist artist  @relation("game_navigator_from_artist_idToartist", fields: [from_artist_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_navigator_artist_id_fk")
  artist_game_navigator_to_artist_idToartist   artist  @relation("game_navigator_to_artist_idToartist", fields: [to_artist_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_navigator_artist_id_fk_2")
  user                                         user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_navigator_user_id_fk")

  @@index([from_artist_id], map: "game_navigator_artist_id_fk")
  @@index([to_artist_id], map: "game_navigator_artist_id_fk_2")
  @@index([created_by], map: "game_navigator_user_id_fk")
}

model artist_stats {
  parent_id           Int
  artist_id           String              @db.Char(22)
  count               Int
  artist              artist              @relation(fields: [artist_id], references: [id], onDelete: Cascade, map: "artist_stats_artist_id_fk")
  artist_stats_parent artist_stats_parent @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "artist_stats_artist_stats_parent_id_fk")

  @@id([parent_id, artist_id])
  @@index([artist_id], map: "artist_stats_artist_id_fk")
}

model artist_stats_parent {
  id           Int            @id @default(autoincrement())
  date         DateTime       @db.Date
  count        Int
  artist_stats artist_stats[]
}

model game_puzzle {
  id         Int     @id @default(autoincrement())
  created_by Int
  track_ids  String  @db.VarChar(256)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_puzzle_user_id_fk")

  @@index([created_by], map: "game_puzzle_user_id_fk")
}

model list {
  id          Int         @id @default(autoincrement())
  created_by  Int
  type        String      @db.VarChar(32)
  name        String      @db.VarChar(512)
  description String?     @db.VarChar(2048)
  icon        String?     @db.VarChar(128)
  user        user        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "list_user_id_fk")
  list_item   list_item[]

  @@index([created_by], map: "list_user_id_fk")
}

model list_item {
  parent_id Int
  item_id   String  @db.Char(22)
  index     Int
  context   String? @db.VarChar(1024)
  list      list    @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "list_item_list_id_fk")

  @@id([parent_id, item_id])
}
