generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
  moduleFormat  = "esm"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model album {
  sid                 String                @id @db.Char(22)
  artists             String?               @db.VarChar(128)
  title               String?               @db.VarChar(128)
  year                Int?                  @db.Year
  cover_art           String?               @db.Char(40)
  game_complete_album game_complete_album[]
}

model game_artwork {
  id            Int     @id @default(autoincrement())
  created_by    Int
  track_id      String  @db.Char(22)
  artwork_blank String  @db.VarChar(64)
  context       String? @db.VarChar(1024)
  track         track   @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_artwork_track_sid_fk")
  user          user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_artwork_user_id_fk")

  @@index([track_id], map: "game_artwork_track_sid_fk")
  @@index([created_by], map: "game_artwork_user_id_fk")
}

model game_complete_album {
  id                       Int                        @id @default(autoincrement())
  created_by               Int
  album_id                 String?                    @db.Char(22)
  context                  String?                    @db.VarChar(1024)
  album                    album?                     @relation(fields: [album_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_album_album_sid_fk")
  user                     user                       @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_album_user_id_fk")
  game_complete_album_item game_complete_album_item[]

  @@index([created_by], map: "game_complete_album_user_id_fk")
  @@index([album_id], map: "game_complete_album_album_sid_fk")
}

model game_complete_album_item {
  id                  Int                 @id @default(autoincrement())
  parent_id           Int
  name                String              @db.VarChar(128)
  artist              String              @db.VarChar(128)
  hidden              Boolean             @default(dbgenerated("b'0'")) @db.Bit(1)
  context             String?             @db.VarChar(1024)
  game_complete_album game_complete_album @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_complete_album_item_8_game_complete_album_id_fk")

  @@index([parent_id], map: "game_complete_album_item_8_game_complete_album_id_fk")
}

model game_complete_lyrics {
  id         Int     @id @default(autoincrement())
  created_by Int
  text       String  @db.Text
  track_id   String  @db.Char(22)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_complete_lyrics_user_id_fk")

  @@index([created_by], map: "game_complete_lyrics_user_id_fk")
}

model game_heardle {
  id         Int     @id @default(autoincrement())
  created_by Int
  track_id   String  @db.Char(22)
  src        String  @db.VarChar(64)
  durations  String  @db.VarChar(128)
  context    String? @db.VarChar(1024)
  track      track   @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_heardle_track_sid_fk")
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_heardle_user_id_fk")

  @@index([track_id], map: "game_heardle_track_sid_fk")
  @@index([created_by], map: "game_heardle_user_id_fk")
}

model game_namex {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       Int
  tracks     Boolean @default(dbgenerated("b'1'")) @db.Bit(1)
  items      String  @db.VarChar(1024)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_namex_user_id_fk")

  @@index([created_by], map: "game_namex_user_id_fk")
}

model game_order {
  id              Int               @id @default(autoincrement())
  created_by      Int
  title           String            @db.VarChar(64)
  show_names      Boolean           @default(dbgenerated("b'1'")) @db.Bit(1)
  context         String?           @db.VarChar(1024)
  user            user              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_order_user_id_fk")
  game_order_item game_order_item[]

  @@index([created_by], map: "game_order_user_id_fk")
}

model game_order_item {
  parent_id  Int
  index      Int
  track_id   String     @db.Char(22)
  context    String?    @db.VarChar(1024)
  game_order game_order @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_order_item_game_order_id_fk")
  track      track      @relation(fields: [track_id], references: [sid], onDelete: NoAction, onUpdate: NoAction, map: "game_order_item_track_sid_fk")

  @@id([parent_id, index])
  @@index([track_id], map: "game_order_item_track_sid_fk")
}

model game_quiz {
  id             Int              @id @default(autoincrement())
  created_by     Int
  title          String?          @db.VarChar(128)
  context        String?          @db.VarChar(1024)
  user           user             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_quiz_user_id_fk")
  game_quiz_item game_quiz_item[]

  @@index([created_by], map: "game_quiz_user_id_fk")
}

model game_quiz_item {
  id        Int       @id @default(autoincrement())
  parent_id Int
  text      String    @db.VarChar(64)
  correct   Boolean   @default(dbgenerated("b'0'")) @db.Bit(1)
  context   String?   @db.VarChar(1024)
  game_quiz game_quiz @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_quiz_item_game_quiz_id_fk")

  @@index([parent_id], map: "game_quiz_item_game_quiz_id_fk")
}

model game_timeline {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       Int     @db.Year
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_timeline_user_id_fk")

  @@index([created_by], map: "game_timeline_user_id_fk")
}

model game_timetable {
  id                  Int                   @id @default(autoincrement())
  created_by          Int
  title               String                @db.VarChar(128)
  color_bg            String                @db.Char(6)
  color_text          String                @db.Char(6)
  context             String?               @db.VarChar(1024)
  user                user                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_timetable_user_id_fk")
  game_timetable_item game_timetable_item[]

  @@index([created_by], map: "game_timetable_user_id_fk")
}

model game_timetable_item {
  id             Int            @id @default(autoincrement())
  parent_id      Int
  name           String         @db.VarChar(64)
  begin          String?        @db.VarChar(5)
  end            String?        @db.VarChar(5)
  hidden         Boolean        @default(dbgenerated("b'0'")) @db.Bit(1)
  context        String?        @db.VarChar(1024)
  game_timetable game_timetable @relation(fields: [parent_id], references: [id], onDelete: Cascade, map: "game_timetable_item_game_timetable_id_fk")

  @@index([parent_id], map: "game_timetable_item_game_timetable_id_fk")
}

model track {
  sid             String            @id @db.Char(22)
  artists         String?           @db.VarChar(128)
  title           String?           @db.VarChar(128)
  year            Int?              @db.Year
  cover_art       String?           @db.Char(40)
  game_artwork    game_artwork[]
  game_heardle    game_heardle[]
  game_order_item game_order_item[]
}

model user {
  id                   Int                    @id @default(autoincrement())
  discord_id           String                 @unique(map: "user_pk") @db.Char(18)
  name                 String                 @db.VarChar(32)
  admin                Boolean                @default(dbgenerated("b'0'")) @db.Bit(1)
  game_artwork         game_artwork[]
  game_complete_album  game_complete_album[]
  game_complete_lyrics game_complete_lyrics[]
  game_heardle         game_heardle[]
  game_map             game_map[]
  game_namex           game_namex[]
  game_order           game_order[]
  game_quiz            game_quiz[]
  game_timeline        game_timeline[]
  game_timetable       game_timetable[]
  game_zoomer          game_zoomer[]
}

model day_schedule {
  day      Int     @id @default(autoincrement())
  type_ids String  @db.VarChar(32)
  game_ids String  @db.VarChar(32)
  theme    String? @db.VarChar(64)
}

model report {
  code        String        @id @db.Char(15)
  dayId       Int
  completed   Boolean       @default(dbgenerated("b'0'")) @db.Bit(1)
  successes   Int           @default(0)
  app         Boolean       @default(dbgenerated("b'0'")) @db.Bit(1)
  report_item report_item[]
}

model report_item {
  parent_code     String  @db.Char(15)
  typeId          Int
  gameId          Int
  success         Boolean @default(dbgenerated("b'0'")) @db.Bit(1)
  attempts        Int?
  items_completed String? @db.VarChar(128)
  items_clicked   String? @db.VarChar(32)
  report          report  @relation(fields: [parent_code], references: [code], onDelete: Cascade, map: "report_item_report_code_fk")

  @@id([parent_code, typeId, gameId])
  @@index([typeId, gameId], map: "report_item_typeId_gameId_index")
}

model game_map {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       String  @db.Char(2)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_map_user_id_fk")

  @@index([created_by], map: "game_map_user_id_fk")
}

model game_zoomer {
  id         Int     @id @default(autoincrement())
  created_by Int
  title      String  @db.VarChar(128)
  goal       String  @db.VarChar(128)
  data       String  @db.VarChar(8192)
  context    String? @db.VarChar(1024)
  user       user    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "game_zoomer_user_id_fk")

  @@index([created_by], map: "game_zoomer_user_id_fk")
}
